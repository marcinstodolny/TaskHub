# Local Docker Compose configuration
# Copy this file to `.env` before running `docker compose up --build`.

# SQL Server SA password (must satisfy SQL Server complexity requirements)
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Local development JWT settings used by the API container
TASKHUB_JWT_ISSUER=TaskHub.Api.Local
TASKHUB_JWT_AUDIENCE=TaskHub.Clients.Local
TASKHUB_JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me-123456789

# Local development demo user used by the Blazor app and demo token endpoint
TASKHUB_DEMO_USERNAME=DefaultUser
TASKHUB_DEMO_PASSWORD=DefaultPassword123!
