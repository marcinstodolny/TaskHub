@implements IDisposable
@inject TaskHub.Web.Auth.AuthSession AuthSession
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TaskHub.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="task-board">
                <span class="bi bi-kanban-fill-nav-menu" aria-hidden="true"></span> Task Board
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="endpoint-tester">
                <span class="bi bi-cloud-arrow-up-fill-nav-menu" aria-hidden="true"></span> Endpoint Tester
            </NavLink>
        </div>

        @if (AuthSession.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <div class="nav-link auth-summary">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Signed in as @AuthSession.Username
                </div>
            </div>

            <div class="nav-item px-3">
                <button type="button" class="nav-link logout-button" @onclick="OnLogoutClickedAsync">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@LoginUrl">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(GetCurrentPath())}";

    protected override void OnInitialized()
    {
        AuthSession.StateChanged += OnAuthStateChanged;
    }

    public void Dispose()
    {
        AuthSession.StateChanged -= OnAuthStateChanged;
    }

    private async Task OnLogoutClickedAsync()
    {
        await AuthSession.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetCurrentPath()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrWhiteSpace(relativePath) ? "/" : $"/{relativePath}";
    }
}
