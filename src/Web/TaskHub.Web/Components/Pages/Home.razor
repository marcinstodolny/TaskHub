@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text.Json
@using TaskHub.Contracts.Common
@using TaskHub.Contracts.TaskList
@using TaskHub.Web.Auth
@inject AuthSession AuthSession
@inject AuthorizedRequestExecutor AuthorizedRequestExecutor
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<PageTitle>TaskHub</PageTitle>

<div class="mb-4">
    <h1>TaskHub</h1>
    <h2 class="h4 mt-3">What is TaskHub?</h2>
    <p class="mb-0">
        TaskHub is a lightweight workspace for organizing your work with task lists and a Kanban-style board.
        You can create lists, add tasks, and move them across statuses to keep delivery visible.
        This home page gives you a quick project overview and shortcuts to the most useful actions.
    </p>
</div>

<section class="mb-4">
    <h2 class="h4">Quick actions</h2>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/task-board">Task Board</a>
        @if (!AuthSession.IsAuthenticated)
        {
            <a class="btn btn-outline-primary" href="/login?returnUrl=%2Ftask-board">Login</a>
        }
        @if (!string.IsNullOrWhiteSpace(_swaggerUrl))
        {
            <a class="btn btn-outline-secondary" href="@_swaggerUrl" target="_blank" rel="noopener noreferrer">Swagger</a>
        }
        @if (Environment.IsDevelopment())
        {
            <a class="btn btn-outline-secondary" href="endpoint-tester">Endpoint Tester</a>
        }
    </div>
</section>

<section>
    <h2 class="h4">Task Lists (preview)</h2>

    @if (!AuthSession.IsAuthenticated)
    {
        <div class="alert alert-info" role="alert">
            Sign in to load your task lists preview.
        </div>
        <a class="btn btn-primary" href="/login?returnUrl=%2F">Login to continue</a>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    else if (_isLoadingTaskLists)
    {
        <div class="alert alert-info" role="status">Loading task lists preview...</div>
    }
    else if (_taskListsPage?.Items is null || !_taskListsPage.Items.Any())
    {
        <div class="alert alert-secondary" role="alert">
            No task lists found yet. Create your first list to start planning.
        </div>
        <a class="btn btn-primary" href="/task-board">Go to Task Board</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Tasks count</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var taskList in _taskListsPage.Items)
                    {
                        <tr>
                            <td>@taskList.Title</td>
                            <td>@taskList.TasksCount</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="/task-board">Open board</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly JsonSerializerOptions _serializerOptions = new() { PropertyNameCaseInsensitive = true };

    private PaginatedResponse<TaskListLightResponse>? _taskListsPage;
    private bool _isLoadingTaskLists;
    private string? _errorMessage;
    private string? _swaggerUrl;

    protected override async Task OnInitializedAsync()
    {
        _swaggerUrl = ResolveSwaggerUrl();
        AuthSession.StateChanged += OnAuthStateChanged;

        if (AuthSession.IsAuthenticated)
        {
            await LoadTaskListsPreviewAsync();
        }
    }

    public void Dispose()
    {
        AuthSession.StateChanged -= OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(HandleAuthStateChangedAsync);
    }

    private async Task HandleAuthStateChangedAsync()
    {
        if (!AuthSession.IsAuthenticated)
        {
            _taskListsPage = null;
            _errorMessage = null;
            _isLoadingTaskLists = false;
            StateHasChanged();
            return;
        }

        if (_taskListsPage is null && !_isLoadingTaskLists)
        {
            await LoadTaskListsPreviewAsync();
            return;
        }

        StateHasChanged();
    }

    private string? ResolveSwaggerUrl()
    {
        var configuredSwaggerUrl = Configuration["TaskHub:Links:SwaggerUrl"];
        if (!string.IsNullOrWhiteSpace(configuredSwaggerUrl))
        {
            return configuredSwaggerUrl;
        }

        if (!Environment.IsDevelopment())
        {
            return null;
        }

        var apiBaseAddress = Configuration["Api:BaseAddress"];
        return string.IsNullOrWhiteSpace(apiBaseAddress)
            ? null
            : $"{apiBaseAddress.TrimEnd('/')}/swagger/index.html";
    }

    private async Task LoadTaskListsPreviewAsync()
    {
        _isLoadingTaskLists = true;
        _errorMessage = null;

        try
        {
            _taskListsPage = await TryLoadTaskListsPreviewAsync();
        }
        catch
        {
            _errorMessage = "Unable to load task lists preview right now.";
        }
        finally
        {
            _isLoadingTaskLists = false;
        }
    }

    private async Task<PaginatedResponse<TaskListLightResponse>?> TryLoadTaskListsPreviewAsync()
    {
        using var response = await AuthorizedRequestExecutor.SendAsync(client => client.GetAsync("/api/TaskList?page=1&count=10"));

        if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            _errorMessage = "Your session expired. Sign in again to load the preview.";
            return null;
        }

        if (response.IsSuccessStatusCode)
        {
            return await response.Content.ReadFromJsonAsync<PaginatedResponse<TaskListLightResponse>>(_serializerOptions);
        }

        _errorMessage = "Unable to load task lists preview right now.";
        return null;
    }
}
