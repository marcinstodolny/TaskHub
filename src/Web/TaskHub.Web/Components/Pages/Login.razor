@page "/login"
@rendermode InteractiveServer
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.Extensions.Options
@using TaskHub.Web.Auth
@inject AuthSession AuthSession
@inject NavigationManager Navigation
@inject IOptions<DemoAuthOptions> DemoAuthOptionsAccessor
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        @if (AuthSession.IsAuthenticated)
        {
            <div class="alert alert-success" role="alert">
                Signed in as <strong>@AuthSession.Username</strong>.
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-primary" href="@GetReturnUrl()">Continue</a>
                <button type="button" class="btn btn-outline-secondary" @onclick="OnLogoutClickedAsync">Logout</button>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted">
                        Sign in with your TaskHub credentials to use the task board and authenticated API calls.
                    </p>

                    <p class="small mb-3">
                        Need an account?
                        <a href="@GetRegisterUrl()">Create one here</a>.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@_errorMessage</div>
                    }

                    @if (ShouldShowDemoAccountHelper)
                    {
                        <div class="border rounded p-3 mb-3 bg-light">
                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">Demo account</div>
                                    <div class="small text-muted">
                                        Username: <span class="font-monospace">@DemoAuthOptions.Username</span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="UseDemoCredentials" disabled="@_isSubmitting">
                                    Use demo credentials
                                </button>
                            </div>
                        </div>
                    }

                    <EditForm Model="_model" OnValidSubmit="OnLoginSubmittedAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <InputText id="username" class="form-control" @bind-Value="_model.Username" disabled="@_isSubmitting" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="password">Password</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" disabled="@_isSubmitting" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                                @(_isSubmitting ? "Signing in..." : "Login")
                            </button>
                            <a class="btn btn-outline-secondary" href="/">Cancel</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "username")]
    public string? InitialUsername { get; set; }

    private readonly LoginFormModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private DemoAuthOptions DemoAuthOptions => DemoAuthOptionsAccessor.Value;

    private bool ShouldShowDemoAccountHelper =>
        Environment.IsDevelopment()
        && DemoAuthOptions.Enabled
        && !string.IsNullOrWhiteSpace(DemoAuthOptions.Username)
        && !string.IsNullOrWhiteSpace(DemoAuthOptions.Password);

    protected override void OnInitialized()
    {
        AuthSession.StateChanged += OnAuthStateChanged;
    }

    public void Dispose()
    {
        AuthSession.StateChanged -= OnAuthStateChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(InitialUsername))
        {
            _model.Username = InitialUsername;
        }
    }

    private async Task OnLoginSubmittedAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var result = await AuthSession.LoginAsync(_model.Username, _model.Password);
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            Navigation.NavigateTo(GetReturnUrl());
        }
        catch (Exception)
        {
            _errorMessage = "Unable to sign in right now. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OnLogoutClickedAsync()
    {
        await AuthSession.LogoutAsync();
    }

    private void UseDemoCredentials()
    {
        _model.Username = DemoAuthOptions.Username;
        _model.Password = DemoAuthOptions.Password;
        _errorMessage = null;
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetReturnUrl()
    {
        if (!IsSafeLocalReturnUrl(ReturnUrl))
        {
            return "/task-board";
        }

        return ReturnUrl!;
    }

    private string GetRegisterUrl()
    {
        var registerUrl = "/register";
        if (!IsSafeLocalReturnUrl(ReturnUrl))
        {
            return registerUrl;
        }

        return $"{registerUrl}?returnUrl={Uri.EscapeDataString(ReturnUrl!)}";
    }

    private static bool IsSafeLocalReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl) || !returnUrl.StartsWith('/'))
        {
            return false;
        }

        if (returnUrl.StartsWith("//", StringComparison.Ordinal) || returnUrl.StartsWith("/\\", StringComparison.Ordinal))
        {
            return false;
        }

        if (!Uri.TryCreate(returnUrl, UriKind.RelativeOrAbsolute, out var parsedUri))
        {
            return false;
        }

        return !parsedUri.IsAbsoluteUri;
    }

    private sealed class LoginFormModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
