@page "/endpoint-tester"
@rendermode InteractiveServer
@using System.Net
@using System.Net.Http.Headers
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using TaskHub.Web.Auth
@inject AuthSession AuthSession
@inject AuthorizedRequestExecutor AuthorizedRequestExecutor
@inject IWebHostEnvironment Environment

<PageTitle>Endpoint Tester</PageTitle>

<h1>Endpoint Tester</h1>

@if (!_isAvailableInCurrentEnvironment)
{
    <div class="alert alert-secondary" role="alert">
        Endpoint tester is available only in local development.
    </div>
}
else if (!AuthSession.IsAuthenticated)
{
    <div class="alert alert-info" role="alert">
        Sign in to send authenticated API requests from the endpoint tester.
    </div>

    <a class="btn btn-primary" href="/login?returnUrl=%2Fendpoint-tester">Login to continue</a>
}
else
{
    <p class="text-muted">Use this page to test TaskHub API endpoints without Swagger. Requests automatically include the token from the current web session.</p>

    <div class="card mb-4">
        <div class="card-body">
            <EditForm Model="_request" OnSubmit="SendRequestAsync">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label" for="httpMethod">Method</label>
                        <InputSelect id="httpMethod" class="form-select" @bind-Value="_request.Method">
                            @foreach (var method in Methods)
                            {
                                <option value="@method">@method</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-10">
                        <label class="form-label" for="endpointPath">Path</label>
                        <InputText id="endpointPath" class="form-control" @bind-Value="_request.Path" placeholder="/api/TaskList" />
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label" for="queryString">Query string (optional)</label>
                    <InputText id="queryString" class="form-control" @bind-Value="_request.QueryString" placeholder="page=1&pageSize=10" />
                </div>

                <div class="mt-3">
                    <label class="form-label" for="requestBody">JSON Body (optional)</label>
                    <InputTextArea id="requestBody" class="form-control font-monospace" rows="8" @bind-Value="_request.Body" />
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_isSending">Send</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadTaskListTemplate">GET Task Lists</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadCreateTaskListTemplate">POST Task List</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LoadCreateTaskItemTemplate">POST Task Item</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

@if (_response is not null)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Response</span>
            <span class="badge @GetStatusCss(_response.StatusCode)">@((int)_response.StatusCode) @_response.StatusCode</span>
        </div>
        <div class="card-body">
            <p><strong>Duration:</strong> @_response.DurationMs ms</p>
            <pre class="bg-light border rounded p-3"><code>@_response.Body</code></pre>
        </div>
    </div>
}

@code {
    private static readonly string[] Methods = ["GET", "POST", "PUT", "DELETE"];
    private readonly JsonSerializerOptions _serializerOptions = new() { WriteIndented = true };

    private EndpointRequest _request = new()
    {
        Method = "GET",
        Path = "/api/TaskList",
        QueryString = "page=1&pageSize=10"
    };

    private EndpointResponse? _response;
    private string? _errorMessage;
    private bool _isSending;
    private bool _isAvailableInCurrentEnvironment;

    protected override void OnInitialized()
    {
        _isAvailableInCurrentEnvironment = Environment.IsDevelopment() || Environment.IsEnvironment("Testing");
    }

    private async Task SendRequestAsync()
    {
        if (!_isAvailableInCurrentEnvironment)
        {
            _errorMessage = "Endpoint tester is available only in local development.";
            return;
        }

        if (!AuthSession.IsAuthenticated)
        {
            _errorMessage = "Sign in before sending authenticated API requests.";
            return;
        }

        _errorMessage = null;
        _response = null;

        if (string.IsNullOrWhiteSpace(_request.Path))
        {
            _errorMessage = "Path is required.";
            return;
        }

        _isSending = true;

        try
        {
            var (response, elapsed) = await SendAuthorizedRequestAsync();
            using var httpResponse = response;

            var body = await httpResponse.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body))
            {
                body = "<empty>";
            }
            else if (TryFormatJson(body, out var formattedBody))
            {
                body = formattedBody;
            }

            _response = new EndpointResponse(httpResponse.StatusCode, body, (long)elapsed.TotalMilliseconds);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSending = false;
        }
    }

    private string BuildRequestUri()
    {
        var trimmedPath = _request.Path.StartsWith('/') ? _request.Path : $"/{_request.Path}";

        return string.IsNullOrWhiteSpace(_request.QueryString)
            ? trimmedPath
            : QueryHelpers.AddQueryString(trimmedPath, ParseQueryString(_request.QueryString));
    }

    private static bool ShouldIncludeBody(string method) =>
        method is "POST" or "PUT" or "PATCH";

    private bool IsValidJson(string payload)
    {
        try
        {
            JsonDocument.Parse(payload);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private bool TryFormatJson(string payload, out string formatted)
    {
        try
        {
            using var jsonDocument = JsonDocument.Parse(payload);
            formatted = JsonSerializer.Serialize(jsonDocument, _serializerOptions);
            return true;
        }
        catch
        {
            formatted = payload;
            return false;
        }
    }

    private async Task<(HttpResponseMessage Response, TimeSpan Duration)> SendAuthorizedRequestAsync()
    {
        var startedAt = DateTime.UtcNow;
        var response = await AuthorizedRequestExecutor.SendAsync(async client =>
        {
            using var message = CreateRequestMessage();
            return await client.SendAsync(message);
        });

        var elapsed = DateTime.UtcNow - startedAt;
        return (response, elapsed);
    }

    private HttpRequestMessage CreateRequestMessage()
    {
        var message = new HttpRequestMessage(new HttpMethod(_request.Method), BuildRequestUri());
        message.Headers.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

        if (ShouldIncludeBody(_request.Method) && !string.IsNullOrWhiteSpace(_request.Body))
        {
            if (!IsValidJson(_request.Body))
            {
                throw new InvalidOperationException("Request body is not valid JSON.");
            }

            message.Content = new StringContent(_request.Body, Encoding.UTF8, "application/json");
        }

        return message;
    }

    private static Dictionary<string, string?> ParseQueryString(string queryString)
    {
        var parsed = QueryHelpers.ParseQuery(queryString);
        return parsed.ToDictionary(kvp => kvp.Key, kvp => (string?)kvp.Value.ToString());
    }

    private static string GetStatusCss(HttpStatusCode statusCode)
    {
        var code = (int)statusCode;

        return code switch
        {
            >= 200 and < 300 => "bg-success",
            >= 400 and < 500 => "bg-warning text-dark",
            >= 500 => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void LoadTaskListTemplate()
    {
        _request.Method = "GET";
        _request.Path = "/api/TaskList";
        _request.QueryString = "page=1&pageSize=10";
        _request.Body = string.Empty;
    }

    private void LoadCreateTaskListTemplate()
    {
        _request.Method = "POST";
        _request.Path = "/api/TaskList";
        _request.QueryString = string.Empty;
        _request.Body = JsonSerializer.Serialize(new
        {
            Title = "My Task List"
        }, _serializerOptions);
    }

    private void LoadCreateTaskItemTemplate()
    {
        _request.Method = "POST";
        _request.Path = "/api/TaskItem";
        _request.QueryString = string.Empty;
        _request.Body = JsonSerializer.Serialize(new
        {
            TaskListId = "00000000-0000-0000-0000-000000000000",
            Title = "Buy groceries",
            Description = "Milk, eggs, and bread",
            Priority = 1
        }, _serializerOptions);
    }

    private sealed class EndpointRequest
    {
        public string Method { get; set; } = "GET";
        public string Path { get; set; } = string.Empty;
        public string QueryString { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
    }

    private sealed record EndpointResponse(HttpStatusCode StatusCode, string Body, long DurationMs);
}
