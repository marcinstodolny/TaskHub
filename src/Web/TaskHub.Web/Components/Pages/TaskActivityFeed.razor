@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.AspNetCore.SignalR.Client
@using TaskHub.Contracts.Common
@using TaskHub.Contracts.TaskActivity
@using TaskHub.Web.Auth
@inject AuthSession AuthSession
@inject AuthorizedRequestExecutor AuthorizedRequestExecutor
@inject IConfiguration Configuration

<section class="activity-panel mt-3">
    <header class="activity-panel-header">
        <h2>Activity</h2>
    </header>

    @if (TaskListId is null)
    {
        <p class="activity-empty">Select a task list to load activity.</p>
    }
    else if (_isLoading)
    {
        <p class="activity-empty">Loading activity...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-warning mb-0">@_errorMessage</div>
    }
    else if (_activities.Count == 0)
    {
        <p class="activity-empty">No activity yet.</p>
    }
    else
    {
        <ol class="activity-list">
            @foreach (var activity in _activities)
            {
                <li class="activity-entry">
                    <div class="activity-message">@activity.Message</div>
                    <time datetime="@activity.CreatedAtUtc.ToString("O")">@FormatTimestamp(activity.CreatedAtUtc)</time>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter]
    public Guid? TaskListId { get; set; }

    [Parameter]
    public int RefreshVersion { get; set; }

    private readonly JsonSerializerOptions _serializerOptions = new() { PropertyNameCaseInsensitive = true };
    private List<TaskActivityResponse> _activities = [];
    private Guid? _loadedTaskListId;
    private string? _errorMessage;
    private bool _isLoading;
    private int _loadedRefreshVersion = -1;
    private int _authStateVersion;
    private HubConnection? _hubConnection;
    private Guid? _joinedTaskListId;
    private bool _isDisposed;

    protected override void OnInitialized()
    {
        AuthSession.StateChanged += OnAuthStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthSession.IsAuthenticated || TaskListId is null)
        {
            await LeaveTaskListGroupAsync();
            ResetFeed();
            return;
        }

        await EnsureLiveActivitySubscriptionAsync();

        if (_loadedTaskListId == TaskListId && _loadedRefreshVersion == RefreshVersion)
        {
            return;
        }

        if (_loadedTaskListId != TaskListId)
        {
            ResetFeed();
        }

        await LoadActivitiesAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        AuthSession.StateChanged -= OnAuthStateChanged;
        await DisposeHubConnectionAsync();
    }

    private void OnAuthStateChanged()
    {
        _ = InvokeAsync(HandleAuthStateChangedAsync);
    }

    private async Task HandleAuthStateChangedAsync()
    {
        _authStateVersion++;
        await DisposeHubConnectionAsync();
        ResetFeed();

        if (AuthSession.IsAuthenticated && TaskListId is not null)
        {
            await EnsureLiveActivitySubscriptionAsync();
            await LoadActivitiesAsync();
        }

        StateHasChanged();
    }

    private async Task EnsureLiveActivitySubscriptionAsync()
    {
        if (_isDisposed || !AuthSession.IsAuthenticated || TaskListId is null)
        {
            await LeaveTaskListGroupAsync();
            return;
        }

        EnsureHubConnection();

        if (_hubConnection is null)
        {
            return;
        }

        try
        {
            if (_hubConnection.State == HubConnectionState.Disconnected)
            {
                await _hubConnection.StartAsync();
            }

            if (_hubConnection.State != HubConnectionState.Connected)
            {
                return;
            }

            var taskListId = TaskListId.Value;
            if (_joinedTaskListId == taskListId)
            {
                return;
            }

            await LeaveTaskListGroupAsync();
            await _hubConnection.InvokeAsync("JoinTaskListGroup", taskListId);
            _joinedTaskListId = taskListId;
        }
        catch
        {
            _joinedTaskListId = null;
        }
    }

    private void EnsureHubConnection()
    {
        if (_hubConnection is not null)
        {
            return;
        }

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(GetHubUrl(), options =>
            {
                options.AccessTokenProvider = async () => await AuthSession.GetRequiredAccessTokenAsync();
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Guid>("TaskListActivityChanged", taskListId =>
        {
            _ = InvokeAsync(() => HandleTaskListActivityChangedAsync(taskListId));
        });

        _hubConnection.Reconnected += _ =>
            InvokeAsync(async () =>
            {
                _joinedTaskListId = null;
                await EnsureLiveActivitySubscriptionAsync();
            });

        _hubConnection.Closed += _ =>
        {
            _joinedTaskListId = null;
            return Task.CompletedTask;
        };
    }

    private string GetHubUrl()
    {
        var apiBaseAddress = Configuration["Api:BaseAddress"] ?? "https://localhost:7040";
        var baseUri = new Uri(apiBaseAddress.TrimEnd('/') + "/");
        return new Uri(baseUri, "hubs/task-activity").ToString();
    }

    private async Task LeaveTaskListGroupAsync()
    {
        if (_hubConnection?.State == HubConnectionState.Connected && _joinedTaskListId is not null)
        {
            try
            {
                await _hubConnection.InvokeAsync("LeaveTaskListGroup", _joinedTaskListId.Value);
            }
            catch
            {
                // The feed still works through HTTP polling/manual refresh when live updates are unavailable.
            }
        }

        _joinedTaskListId = null;
    }

    private async Task HandleTaskListActivityChangedAsync(Guid taskListId)
    {
        if (_isDisposed || !AuthSession.IsAuthenticated || TaskListId != taskListId)
        {
            return;
        }

        await LoadActivitiesAsync();
        StateHasChanged();
    }

    private async ValueTask DisposeHubConnectionAsync()
    {
        var connection = _hubConnection;
        _hubConnection = null;
        _joinedTaskListId = null;

        if (connection is null)
        {
            return;
        }

        try
        {
            await connection.DisposeAsync();
        }
        catch
        {
            // Component disposal should not fail because a live-update connection is already closed.
        }
    }

    private async Task LoadActivitiesAsync()
    {
        if (TaskListId is null)
        {
            ResetFeed();
            return;
        }

        var authStateVersion = _authStateVersion;
        var taskListId = TaskListId.Value;
        var refreshVersion = RefreshVersion;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var response = await AuthorizedRequestExecutor.SendAsync(
                client => client.GetAsync($"/api/TaskList/{taskListId}/activities?page=1&count=50"));

            if (!IsCurrentState(authStateVersion, taskListId, refreshVersion))
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await GetErrorMessageAsync(response, "Unable to load activity.");
                _activities = [];
                return;
            }

            var feed = await response.Content.ReadFromJsonAsync<PaginatedResponse<TaskActivityResponse>>(_serializerOptions);
            if (!IsCurrentState(authStateVersion, taskListId, refreshVersion))
            {
                return;
            }

            _activities = feed?.Items?.ToList() ?? [];
            _loadedTaskListId = taskListId;
            _loadedRefreshVersion = refreshVersion;
        }
        catch
        {
            if (IsCurrentState(authStateVersion, taskListId, refreshVersion))
            {
                _errorMessage = "Unable to load activity.";
                _activities = [];
            }
        }
        finally
        {
            if (IsCurrentState(authStateVersion, taskListId, refreshVersion))
            {
                _isLoading = false;
            }
        }
    }

    private void ResetFeed()
    {
        _activities = [];
        _loadedTaskListId = null;
        _loadedRefreshVersion = -1;
        _errorMessage = null;
        _isLoading = false;
    }

    private async Task<string> GetErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            return "Your session expired. Sign in again to continue working on the task board.";
        }

        var responseText = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(responseText))
        {
            return fallbackMessage;
        }

        try
        {
            var problem = JsonSerializer.Deserialize<ProblemDetailsResponse>(responseText, _serializerOptions);
            return problem?.Detail ?? fallbackMessage;
        }
        catch
        {
            return fallbackMessage;
        }
    }

    private bool IsCurrentState(int authStateVersion, Guid taskListId, int refreshVersion)
    {
        return authStateVersion == _authStateVersion
               && AuthSession.IsAuthenticated
               && TaskListId == taskListId
               && RefreshVersion == refreshVersion;
    }

    private static string FormatTimestamp(DateTime createdAtUtc)
    {
        var timestamp = createdAtUtc.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Utc)
            : createdAtUtc.ToUniversalTime();

        return timestamp.ToLocalTime().ToString("g");
    }
}
